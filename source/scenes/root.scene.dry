@start
on-arrival: {!
Q.started = 1;
// time elapsed (in half-months/bi-weekly periods)
Q.time = 1;
Q.year = 1972;
Q.month = 1;
Q.week = 1; // 1 = first half of month (week 1), 2 = second half of month (week 3)
// how many actions have been taken this period?
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics
Q.old_demographics = 0;
// use decimals for reichstag seats
Q.use_decimals = 1; // Enable decimal display for Turkish election results

// party resources
Q.resources = 2;
// party dues
Q.dues = 2;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// factions
Q.factions = ['kemalist_marxists', 'left_kemalists', 'orthodox_kemalists', 'right_kemalists', 'third_worldists'];

// Third Worldists: a minor faction, disabled by default. Toggle Q.third_worldists_enabled
// to 1 to make it appear in the party UI (Congress Seat Distribution, Party Quarters,
// Internal Factions list), where it is positioned to the right of the Kemalist Marxists.
Q.third_worldists_enabled = 0;
Q.third_worldists_color = '#5f0f91';
Q.third_worldists_dissent = 20;

// Per-quarter faction strengths (source of truth)
// Quarters: Grassroots(20%), Base(15%), Bureaucracy(25%), TBMM(20%), Intelligentsia(10%), Local Leadership(10%)
// q2 (Bureaucracy) base values are lower because party leadership figures add +1 each dynamically.
// Starting leadership: İnönü(ok), Kırıkoğlu(km), Ecevit(lk), Satır(ok) → bonus km=1, lk=1, ok=2, rk=0
// So q2 base + bonus = effective: km(-1+1=0), lk(1+1=2), ok(2+2=4), rk(1+0=1)
Q.q0_km_str = 2; Q.q0_lk_str = 4; Q.q0_ok_str = 2; Q.q0_rk_str = 1; Q.q0_tw_str = 3;
Q.q1_km_str = 1; Q.q1_lk_str = 4; Q.q1_ok_str = 2; Q.q1_rk_str = 1; Q.q1_tw_str = 2;
Q.q2_km_str = 0; Q.q2_lk_str = 1; Q.q2_ok_str = 2; Q.q2_rk_str = 1; Q.q2_tw_str = 1;
Q.q3_km_str = 1; Q.q3_lk_str = 3; Q.q3_ok_str = 3; Q.q3_rk_str = 2; Q.q3_tw_str = 2;
Q.q4_km_str = 2; Q.q4_lk_str = 4; Q.q4_ok_str = 2; Q.q4_rk_str = 1; Q.q4_tw_str = 2;
Q.q5_km_str = 1; Q.q5_lk_str = 3; Q.q5_ok_str = 3; Q.q5_rk_str = 1; Q.q5_tw_str = 1;

// Advisor-to-faction mapping for dynamic Bureaucracy quarter (q2) computation.
// km = kemalist_marxist, lk = left_kemalist, ok = orthodox_kemalist, rk = right_kemalist, nf = nonfactional
Q._advisor_factions = 'kirikoglu:km,avcioglu:km,selcuk:km,belli:km,ecevit:lk,baykal:lk,gunes:lk,aksoy:lk,ustundag:lk,rahsan:lk,topuz:lk,sav:lk,inonu:ok,satir:ok,eyuboglu:ok,gogus:rk,paksut:rk,celikbas:rk,muezzinoglu:nf,erdem:nf,ugur:nf,akan:nf';

// Compute initial global strengths as weighted averages of per-quarter values
// q2 effective values = q2 base + party leadership bonus (computed dynamically)
var _qW = [0.20, 0.15, 0.25, 0.20, 0.10, 0.10];
var _fKeys = ['km', 'lk', 'ok', 'rk', 'tw'];
var _fGlobals = ['kemalist_marxists_strength', 'left_kemalists_strength', 'orthodox_kemalists_strength', 'right_kemalists_strength', 'third_worldists_strength'];

// Compute party leadership bonus for q2
var _afMap = {};
Q._advisor_factions.split(',').forEach(function(e) { var p = e.split(':'); _afMap[p[0]] = p[1]; });
var _q2Bonus = {km: 0, lk: 0, ok: 0, rk: 0, tw: 0};
var _advisorList = Object.keys(_afMap);
for (var _ai = 0; _ai < _advisorList.length; _ai++) {
    var _aName = _advisorList[_ai];
    if (Q[_aName + '_advisor'] === 1) {
        var _aFaction = _afMap[_aName];
        if (_aFaction !== 'nf') {
            _q2Bonus[_aFaction] += 1;
        }
    }
}

for (var _fi = 0; _fi < _fKeys.length; _fi++) {
    var _sum = 0;
    for (var _qi = 0; _qi < 6; _qi++) {
        var _val = Q['q' + _qi + '_' + _fKeys[_fi] + '_str'];
        if (_qi === 2) _val = Math.max(0, _val + _q2Bonus[_fKeys[_fi]]); // add leadership bonus to q2, clamp >= 0
        _sum += _qW[_qi] * _val;
    }
    Q[_fGlobals[_fi]] = _sum;
    Q['_last_' + _fKeys[_fi] + '_str'] = _sum;
}

Q.kemalist_marxists_dissent = 20;
Q.left_kemalists_dissent = 20;
Q.orthodox_kemalists_dissent = 5;
Q.right_kemalists_dissent = 10;
Q.right_kemalist_deal = 0;
Q.right_kemalists_resign = 0;
Q.right_kemalist_split = 0;
Q.orthodox_kemalist_destruction = 0;

// Congress tracking
Q.congress_upcoming = 1;
Q.congress_year = 1972;
Q.congress_month = 5;
Q.congress_candidate_1 = "ecevit";
Q.congress_candidate_2 = "inonu";
// Faction support: 1 = candidate_1 (Ecevit), 2 = candidate_2 (İnönü), 0 = undecided
Q.kemalist_marxists_support = 0;
Q.left_kemalists_support = 1;
Q.orthodox_kemalists_support = 2;
Q.right_kemalists_support = 2;
Q.third_worldists_support = 0;

// secret events...
Q.unions_independent = 0;
Q.centrists_resign = 0;
Q.left_split = 0;
Q.reformists_resigned = 0;

// Whether İnönü stays (0 = initial, 1 = undecided, 2 = stays, -1 = leaves)
Q.inonu_stay = 0;

// Status of the Turkish Democracy
Q.democracystatus = 30
Q.paramilitary_pressure_timer = 0;

// crisis_urgency indicates how seriously the <span style="color: #E3000F;">**CHP**</span> is taking the economic crisis - scale from 0 to 10.
Q.crisis_urgency = 0;
// nazi_urgency indicates how seriously the <span style="color: #E3000F;">**CHP**</span> takes the nazis - scale from 0 to 10.
Q.nazi_urgency = 0;
// radicalization indicates how radical the CHP's rhetoric is - scale from 0 to 10.
Q.radicalization = 0;
// Support for the WTB plan and proto-Keynesian works creation plans in general
Q.wtb_support = 0;
// Support for Pacifism within the <span style="color: #E3000F;">**CHP**</span> relative to 1928
Q.pacifism = 0;
// Support for democratic reform within the <span style="color: #E3000F;">**CHP**</span> relative to 1928
Q.democratization = 0;
// Support for a communist coalition relative to 1928
Q.communist_coalition = 0;
// economic_plan: have we adopted *any* economic plan?
// 1 - WTB plan, 2 - AfA-bund plan, 3 - radical plan (mass nationalization of industries)
Q.economic_plan = 0;
// have we officially adopted the WTB plan?
Q.wtb_adopted = 0;
// have we formed the iron front?
Q.iron_front_formed = 0;
// people's party support
Q.peoples_party_support = 0;
// support for nationalizations
Q.nationalization_support = 0;
Q.nationalization_adopted = 0;
// moderate economic plan
Q.moderate_plan_support = 0;
Q.moderate_plan_adopted = 0;

// organizations

// inter-party relations
Q.TIP_relation = 40;
Q.CGP_relation = 35;
Q.z_relation = 30;
Q.DP_relation = 20;
// MSP and MHP are invariably hostile
Q.MSP_relation = 10;
Q.MHP_relation = 10;

// DP collapse variable - if true, DP loses 80% of its support to AP between 1974 and 1977
Q.DP_collapse = 0;

Q.TIP_leader = "Unorganized";
// alternative TIP leaders: Mehmet Ali Aybar, Behice Boran
Q.TIP_party_leader = "Unorganized";
Q.z_leader = "Demirel";
Q.z_party_leader = "Demirel";
Q.DP_leader = "Bozbeyli";
Q.DP_party_leader = "Bozbeyli";
Q.CGP_leader = "Feyzioğlu";
Q.CGP_party_leader = "Feyzioğlu";
Q.MSP_leader = "Süleyman Arif";
// alternative MSP leader: Erbakan
Q.MSP_party_leader = "Süleyman Arif";
Q.CHP_leader = "İnönü";
// alternative <span style="color: #E3000F;">**CHP**</span> leader: Ecevit
Q.CHP_party_leader = "İnönü";
Q.chp_party_leader = "İnönü";
Q.party_leader_id = "inonu";
Q.party_secretary = "Kırıkoğlu";
Q.party_secretary_id = "kirikoglu";
Q.MHP_leader = "Alparslan Türkeş"
Q.MHP_party_leader = "Alparslan Türkeş"

// Municipality control system
Q.municipalities_controlled = 21;
Q.total_municipalities = 67;
Q.municipality_control_level = 1; // 0=Terrible, 1=Poor, 2=Divided, 3=Satisfactory, 4=Overwhelming
Q.local_total_seats = 67;
Q.local_election_threshold = 8;

// Interior affairs policy baselines (numeric: 0 = worst/bad start)
Q.land_reform_level = 0;
Q.natural_resources_level = 0;
Q.workplace_democracy_level = 0;
Q.peoples_sector_level = 0;
Q.workplace_safety_level = 0;
Q.minimum_wage_level = 0;
Q.judicial_reform_level = 0;
Q.counter_guerilla_discovered = 0;
Q.counter_guerilla_level = 0;
Q.education_funding_level = 0;
Q.education_curriculum_level = 0;
Q.university_freedom_level = 0;
Q.university_prestige_level = 0;
Q.womens_legal_level = 2;
Q.womens_workplace_level = 0;
Q.household_violence_level = 0;
Q.language_rights_level = 0;

// hmm... maybe we can play nice with Hindenburg???
Q.hindenburg_relation = 25;


// Does the <span style="color: #E3000F;">**CHP**</span> lead in Prussia?
Q.CHP_prussia = 1;
// Options: CHP, z, MSP, papen, MHP
Q.prussian_government = "CHP";

// The array of forces - Turkish paramilitary groups
// Number of members (in thousands)
// Far Left organizations
Q.thkpc_strength = 2;
Q.thkpc_militancy = 0.5;
Q.thkpc_destroyed = 0;
Q.thkpc_banned = 0;	

Q.tkpml_strength = 0.1;
Q.tkpml_militancy = 0.8;	
Q.tkpml_formed = 0;	
Q.tkpml_banned = 0;

Q.devyol_strength = 55;
Q.devyol_militancy = 0.25;
Q.devyol_formed = 0;
Q.devyol_banned = 0;

// Separatist organizations
Q.pkk_base_strength = 8;
Q.pkk_militancy = 0.5;
Q.pkk_formed = 0;
Q.pkk_strength = 0;

// State forces
Q.police_strength = 60;
Q.police_militancy = 0.8;
Q.police_loyalty = 0.65; // Mostly loyal (0.54-0.71 range)

// Far Right organizations  
Q.grey_wolves_strength = 25;
Q.grey_wolves_militancy = 0.1;
Q.grey_wolves_banned = 0;

Q.raiders_strength = 30;
Q.raiders_militancy = 0.05;
Q.raiders_formed = 0;
Q.raiders_banned = 0;

Q.tit_strength = 0.5;
Q.tit_militancy = 0.9;
Q.tit_banned = 0;

// Keep these for compatibility with existing events, but set to 0 for Turkish context
Q.interior_police_strength = 0;
Q.interior_police_militancy = 1;
Q.interior_police_loyalty = 0.45;

Q.prussian_police_strength = 0;
Q.prussian_police_militancy = 1;
Q.prussian_police_loyalty = 0.5;

// Turkish Army Strength (0-1 scale, starting at 0.4 = Adequate)
Q.army_land_strength = 0.4;
Q.army_naval_strength = 0.4;
Q.army_aerial_strength = 0.4;

// Political Violence Calculation System
Q.streetfighting_joever = 0;

// Calculate paramilitary force effectiveness (strength × militancy)
Q.far_left_force = 0;
Q.far_right_force = 0;
Q.separatist_force = 0;
Q.state_force = 0;
Q.democracy_force = 0;

// Separatist forces calculation (strength × militancy)
if (Q.kurdish_radicalism >= 0.69) {
    Q.pkk_formed = 1;
    Q.pkk_strength = Q.pkk_base_strength * (2 * Q.kurdish_political_consciousness);
    Q.pkk_force = Q.pkk_strength * Q.pkk_militancy;
    Q.separatist_force += Q.pkk_force;
} else {
    Q.pkk_formed = 0;
    Q.pkk_strength = 0;
    Q.pkk_force = 0;
}

// Far left forces calculation (strength × militancy)
if (!Q.thkpc_destroyed) {
    Q.thkpc_force = Q.thkpc_strength * Q.thkpc_militancy;
    Q.far_left_force += Q.thkpc_force;
} else {
    Q.thkpc_strength = 0;
}
if (Q.devyol_formed) {
    Q.devyol_force = Q.devyol_strength * Q.devyol_militancy;
    Q.far_left_force += Q.devyol_force;
}
if (Q.tkpml_formed) {
    Q.tkpml_force = Q.tkpml_strength * Q.tkpml_militancy;
    Q.far_left_force += Q.tkpml_force;
}
// Far right forces calculation (strength × militancy)
Q.grey_wolves_force = Q.grey_wolves_strength * Q.grey_wolves_militancy;
Q.far_right_force += Q.grey_wolves_force;

if (Q.raiders_formed) {
    Q.raiders_force = Q.raiders_strength * Q.raiders_militancy;
    Q.far_right_force += Q.raiders_force;
}

Q.tit_force = Q.tit_strength * Q.tit_militancy;
Q.far_right_force += Q.tit_force;

// State forces calculation (strength × militancy)
Q.police_force = Q.police_strength * Q.police_militancy;
Q.interior_police_force = Q.interior_police_strength * Q.interior_police_militancy; // 0 for Turkish context
Q.prussian_police_force = Q.prussian_police_strength * Q.prussian_police_militancy; // 0 for Turkish context

Q.state_force = Q.police_force + Q.interior_police_force + Q.prussian_police_force;

// Democratic forces (state forces when not controlled by extremists)
Q.democracy_force = Q.state_force;

// Total forces for percentage calculation
Q.total_forces = Q.far_left_force + Q.far_right_force + Q.separatist_force + Q.state_force;

// Convert to percentages
if (Q.total_forces > 0) {
    Q.far_left_force_percent = Math.round((Q.far_left_force / Q.total_forces) * 100);
    Q.far_right_force_percent = Math.round((Q.far_right_force / Q.total_forces) * 100);
    Q.separatist_force_percent = Math.round((Q.separatist_force / Q.total_forces) * 100);
    Q.state_force_percent = Math.round((Q.state_force / Q.total_forces) * 100);
    Q.democracy_force_percent = Q.state_force_percent;
    
    // Individual organization force percentages
    if (!Q.thkpc_destroyed) {
        Q.thkpc_force_percent = Math.round((Q.thkpc_force / Q.total_forces) * 100);
    }
    if (Q.pkk_formed) {
        Q.pkk_force_percent = Math.round((Q.pkk_force / Q.total_forces) * 100);
    }
    if (Q.devyol_formed) {
        Q.devyol_force_percent = Math.round((Q.devyol_force / Q.total_forces) * 100);
    }	
    if (Q.tkpml_formed) {
        Q.tkpml_force_percent = Math.round((Q.tkpml_force / Q.total_forces) * 100);
    }
    Q.grey_wolves_force_percent = Math.round((Q.grey_wolves_force / Q.total_forces) * 100);
    if (Q.raiders_formed) {
        Q.raiders_force_percent = Math.round((Q.raiders_force / Q.total_forces) * 100);
    }
    Q.tit_force_percent = Math.round((Q.tit_force / Q.total_forces) * 100);
    
    Q.police_force_percent = Math.round((Q.police_force / Q.total_forces) * 100);
    Q.interior_police_force_percent = Math.round((Q.interior_police_force / Q.total_forces) * 100);
    Q.prussian_police_force_percent = Math.round((Q.prussian_police_force / Q.total_forces) * 100);
}

// Determine street control levels
Q.far_right_paramilitary = Q.far_right_force_percent > Q.state_force_percent;
Q.far_left_paramilitary = Q.far_left_force_percent > Q.state_force_percent;
Q.separatist_paramilitary = Q.separatist_force_percent > Q.state_force_percent;
Q.democracy_paramilitary = Q.democracy_force_percent >= Math.max(Q.far_left_force_percent, Q.far_right_force_percent);
Q.state_paramilitary = Q.state_force_percent >= Math.max(Q.far_left_force_percent, Q.far_right_force_percent);

// Determine control intensity levels
if (Q.far_right_paramilitary) {
    if (Q.far_right_force_percent >= 70) Q.far_right_paramilitary_highest = 1;
    else if (Q.far_right_force_percent >= 60) Q.far_right_paramilitary_high = 1;
    else if (Q.far_right_force_percent >= 50) Q.far_right_paramilitary_med = 1;
    else Q.far_right_paramilitary_low = 1;
}

if (Q.democracy_paramilitary) {
    if (Q.democracy_force_percent >= 70) Q.democracy_paramilitary_highest = 1;
    else if (Q.democracy_force_percent >= 60) Q.democracy_paramilitary_high = 1;
    else if (Q.democracy_force_percent >= 50) Q.democracy_paramilitary_med = 1;
    else Q.democracy_paramilitary_low = 1;
}

if (Q.state_paramilitary) {
    if (Q.state_force_percent >= 70) Q.state_paramilitary_highest = 1;
    else if (Q.state_force_percent >= 60) Q.state_paramilitary_high = 1;
    else if (Q.state_force_percent >= 50) Q.state_paramilitary_med = 1;
    else Q.state_paramilitary_low = 1;
}

// Grey Wolves street control vote bonus for middle class (petty bourgeoisie)
// Applied at initialization only - recalculations happen elsewhere
if (Q.grey_wolves_force_percent > Q.state_force_percent && Q.grey_wolves_force_percent > Q.far_left_force_percent && Q.grey_wolves_force_percent > 30) {
    Q.grey_wolves_control_bonus = Math.floor((Q.grey_wolves_force_percent - 30) / 10) * 4;
    Q.petty_bourgeoisie_MHP += Q.grey_wolves_control_bonus;
    // Ensure we don't exceed 100% and redistribute proportionally if needed
    if (Q.petty_bourgeoisie_MHP > 100) {
        Q.petty_bourgeoisie_MHP = 100;
    }
}

// strength includes actual military and de facto reserves?
Q.reichswehr_strength = 100;
Q.reichswehr_militancy = 5;
Q.reichswehr_loyalty = 0.2;

// The state of the country

// popular opinion
// national ideology - on a binary scale
// nationalism vs internationalism or pacifism or non-nationalism
Q.nationalism = 80;
// socialism vs capitalism
Q.socialism = 6;
// pro-republic vs anti-republic
Q.pro_republic = 86;

Q.emergency_rule = 0;

// minimum percentage of votes to be represented in the Reichstag
Q.electoral_threshold = 0;
// constitutional reform level
Q.constitutional_reform = 0;
// constructive vote of no confidence
Q.constructive_vonc = 0;
// reduction in presidential powers
Q.presidential_powers = 0;
// allows banning of non-constitutional parties
Q.constitutional_protection = 0;
Q.TIP_banned = 1;
Q.MHP_banned = 0;

// coups and capital strikes happen when you upset the right or the capitalists too much with your policies. they're an additional check on your policies, when purely electoral checks don't suffice.
// when coup_progress reaches 10 or capital_strike_progress reaches 10, there's a special event that launches the coup.
Q.coup_progress = 0;
Q.capital_strike_progress = 0;

// TSK (Turkish Armed Forces) coup timer system (0-15)
Q.coup_timer = 0;

// TSK status tracking
Q.army_in_government = 1; // Starting with Nihat Erim military government
Q.tsk_pacified = 0;

// Kurdish Nationalism system
Q.kurdish_political_consciousness = 0.20; // Starting position: Low (0.14-0.24)
Q.kurdish_radicalism = 0.25; // Starting position: Medium-low (0.24-0.44)


// Factors affecting Kurdish Nationalism
// Consciousness
Q.eastern_crime = 5
Q.CHP_kurdish_attitude = 0
Q.ddkd_formed = 0

// Radicalism
// CHP attitude here too
// tip being banned
// ddkd here too

// Union Relations system
Q.disk_relation = 35; // Starting at "cool" (29.9-39.9 range)
Q.disk_turkis_conflict = 0.50; // Starting at "Balanced" (0.40-0.60)
Q.union_reform = "no";

// Update army_in_government based on chancellor_party
if (Q.chancellor_party == 'I') {
    Q.army_in_government = 1;
} else {
    Q.army_in_government = 0;
}

Q.budget = 1;
Q.yearly_budget = 0;

// Proportion of different social groups - Turkish demographics circa 1972-1977
Q.rural = 45; // Rural population
Q.workers = 15; // Industrial workers  
Q.petty_bourgeoisie = 15; // Small business owners, artisans
Q.state_employees = 7; // State employees and bureaucrats
Q.capitalists = 3; // Capitalists and land owners
Q.alevis = 10; // Alevi religious minority

// Kurdish demographic percentage based on political consciousness level
if (Q.kurdish_political_consciousness < 0.05) {
    Q.kurds = 0; // Nonexistent - 0%
} else if (Q.kurdish_political_consciousness >= 0.05 && Q.kurdish_political_consciousness < 0.14) {
    Q.kurds = 3; // Very low - 3%
} else if (Q.kurdish_political_consciousness >= 0.14 && Q.kurdish_political_consciousness < 0.24) {
    Q.kurds = 5; // Low - 5%
} else if (Q.kurdish_political_consciousness >= 0.24 && Q.kurdish_political_consciousness < 0.44) {
    Q.kurds = 7; // Medium-low - 7%
} else if (Q.kurdish_political_consciousness >= 0.44 && Q.kurdish_political_consciousness < 0.69) {
    Q.kurds = 9; // Medium - 9%
} else if (Q.kurdish_political_consciousness >= 0.69 && Q.kurdish_political_consciousness < 0.89) {
    Q.kurds = 11; // High - 11%
} else {
    Q.kurds = 15; // Very high - 15%
}

// income for industrial workers 
Q.income = 1600;

// Historical economic baseline data by year (Turkish context)
Q.historical_inflation = {
    1972: 15.3,
    1973: 15.8,
    1974: 15.4,
    1975: 19.0,
    1976: 16.4,
    1977: 22.5,
    1978: 53.3,
    1979: 62.0
};

Q.historical_gdp_growth = {
    1972: 9.2,
    1973: 4.9,
    1974: 3.3,
    1975: 6.1,
    1976: 9.0,
    1977: 3.0,
    1978: 1.2,
    1979: -0.5
};

Q.historical_unemployment = {
    1972: 4.6,
    1973: 6.5,
    1974: 8.0,
    1975: 7.5,
    1976: 8.5,
    1977: 9.7,
    1978: 10.1,
    1979: 8.9
};

// Set base economic values based on starting year (1972)
Q.base_inflation = Q.historical_inflation[Q.year] || 15.3;
Q.base_growth = Q.historical_gdp_growth[Q.year] || 9.2;
Q.base_unemployment = Q.historical_unemployment[Q.year] || 4.6;

// Player deviation variables (only these change via player actions)
Q.inflation_modifier = 0;
Q.growth_modifier = 0;
Q.unemployment_modifier = 0;
Q.industry_modifier = 0;
Q.agriculture_modifier = 0;
Q.forex_pressure_delayed_reduction = 0;

// Set initial economic values from base + modifiers
Q.inflation = Q.base_inflation + Q.inflation_modifier;
Q.economic_growth = Q.base_growth + Q.growth_modifier;
Q.unemployed = Q.base_unemployment + Q.unemployment_modifier;

// Historical Industrial Production Index (base year 1972 = 100)
Q.historical_industrial_index = {
    1972: 100,
    1973: 110,
    1974: 120,
    1975: 132,
    1976: 145,
    1977: 158,
    1978: 150,
    1979: 142
};

// Historical Agricultural Production Index (base year 1972 = 100)
Q.historical_agricultural_index = {
    1972: 100,
    1973: 102,
    1974: 105,
    1975: 108,
    1976: 111,
    1977: 113,
    1978: 115,
    1979: 117
};

Q.base_industry_index = Q.historical_industrial_index[Q.year] || 100;
Q.base_agriculture_index = Q.historical_agricultural_index[Q.year] || 100;

Q.getForexFactors = function() {
    var industry = Q.forex_industry_penalty || 0.6;
    var ratio = Q.forex_agriculture_ratio || 3;
    var agriculture = Q.forex_agriculture_penalty || industry / ratio;
    return {industry: industry, agriculture: agriculture, ratio: ratio};
};

// Current Production Indices
Q.industrial_production_index = Q.historical_industrial_index[Q.year] || 100;
Q.agricultural_production_index = Q.historical_agricultural_index[Q.year] || 100;

// Player modifications to production indices (cumulative effects from player actions)
Q.industrial_player_modifier = 0;
Q.agricultural_player_modifier = 0;

// Variables for making production changes (used by government actions)
Q.industrial_change = 0;
Q.agricultural_change = 0;
