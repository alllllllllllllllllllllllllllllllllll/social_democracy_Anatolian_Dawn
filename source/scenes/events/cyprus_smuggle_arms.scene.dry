title: Right Kemalist delegates join CGP.
view-if: year = 1999 and month = 9 and week = 2 and right_kemalist_split = 1
max-visits: 1
tags: event
new-page: true
on-display: {!
var cardEl = document.createElement('div');
cardEl.className = "face-figure2";
var image = new Image();
image.className = "face-img";
image.src = "img/landforces.webp";
cardEl.appendChild(image);
var contentDiv = document.querySelector("#page #mid_panel #content");
contentDiv.appendChild(cardEl);
!}

= Turkish Land Forces

