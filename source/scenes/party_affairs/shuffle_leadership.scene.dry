is-card: true
card-image: img/portraits/IlhanSelcuk.jpg
view-if: selcuk_advisor = 0 and n_advisors < 2 and party_leader_id != "selcuk" and party_secretary_id != "selcuk"
on-arrival: selcuk_advisor = 1; n_advisors += 1
go-to: advisor_menu
tags: kemalist_marxist_advisor

