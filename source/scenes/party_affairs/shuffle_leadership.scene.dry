####################### adding advisors

@add_advisors
title: Add members
choose-if: n_advisors < 2
unavailable-subtitle: Maximum of 2 members.
go-to: advisor_menu

@advisor_menu
title: Add other members.
tags: kemalist_marxist_advisor, left_kemalist_advisor, orthodox_kemalist_advisor, right_kemalist_advisor, nonfactional_advisor
frequency: 1


- @kemalist_marxist: Add Kemalist Marxists
- @left_kemalist: Add Leftist Kemalists
- @orthodox_kemalist: Add Reformist Kemalists
- @right_kemalist: Add Right Kemalists
- @nonfactional: Add non-factional members
- @rm_main: Remove members instead.
- @remove_none: Stop changing members.

@kemalist_marxist
view-if: n_advisors < 2

- #kemalist_marxist_advisor

@left_kemalist
view-if: n_advisors < 2

- #left_kemalist_advisor

@orthodox_kemalist
view-if: n_advisors < 2

- #orthodox_kemalist_advisor

@right_kemalist
view-if: right_kemalists_strength > 0 and n_advisors < 2

- #right_kemalist_advisor

@nonfactional
view-if: n_advisors < 2

- #nonfactional_advisor

# kemalist marxist

@add_kirikoglu
title: Kamil Kırıkoğlu
subtitle: Kamil Kırıkoğlu is the general secretary of the party and a respected member of the Marxist clique.
