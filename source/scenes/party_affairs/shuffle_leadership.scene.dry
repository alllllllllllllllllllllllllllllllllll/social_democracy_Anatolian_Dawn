card-image: img/portraits/TarikAkan.jpg
view-if: akan_advisor = 0 and n_advisors < 2 and CHP_party_leader == "Ecevit" and year >= 1975 and party_leader_id != "akan" and party_secretary_id != "akan"
on-arrival: akan_advisor = 1; n_advisors += 1
go-to: advisor_menu
tags: nonfactional_advisor

