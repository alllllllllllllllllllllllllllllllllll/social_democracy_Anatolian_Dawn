title: Election Simulation
set-jump: post_election


- @1928: 1973 historical scenario
- @1930: 1977 historical scenario
- @1932: 1979 historical scenario(by-election)

@1928
on-arrival: {!
// Turkish demographic groups with accurate percentages
Q.rural = 45; // Rural population
Q.workers = 15; // Industrial workers  
Q.petty_bourgeoisie = 15; // Small business owners, artisans
Q.state_employees = 7; // State employees and bureaucrats
Q.capitalists = 3; // Capitalists and land owners
Q.alevis = 10; // Alevi religious minority
Q.kurds = 5; // Kurdish political movement

Q.classes = ['rural', 'workers', 'petty_bourgeoisie', 'state_employees', 'capitalists', 'alevis', 'kurds'];
Q.parties = ['chp', 'TIP', 'z', 'CGP', 'DP', 'MSP', 'MHP', 'other'];
Q.disk_endorsement = false;
Q.sim_prev_TIP_banned = (typeof Q.TIP_banned !== 'undefined') ? Q.TIP_banned : 1;
Q.TIP_banned = 0; // TİP ran openly in these historical elections; restored after the simulation in post_election
Q.use_decimals = true;
Q.sim_year = 1973;
// the simulation may be entered directly from the start menu, before the main
// game state (and CGP_name) has been initialized
if (typeof Q.CGP_name === 'undefined') {
    Q.CGP_name = 'CGP';
}

// 1973 general election results: CHP 33%, TIP 0%, AP 30%, DP 12%, MSP 12%, CGP 5%, MHP 3%, Others 5%.
// Applied uniformly across every demographic group so the simulated national result matches exactly.
for (var c of Q.classes) {
    Q[c + '_chp'] = 33;
    Q[c + '_TIP'] = 0;
    Q[c + '_z'] = 30; // AP uses 'z' variable
    Q[c + '_DP'] = 12;
    Q[c + '_MSP'] = 12;
    Q[c + '_CGP'] = 5;
    Q[c + '_MHP'] = 3;
    Q[c + '_other'] = 5;
}
!}
go-to: election_algorithm
set-jump: post_election

@1930
on-arrival: {!
// Turkish demographic groups with accurate percentages - 1930 variation
Q.rural = 45; // Rural population
Q.workers = 15; // Industrial workers  
Q.petty_bourgeoisie = 15; // Small business owners, artisans
Q.state_employees = 7; // State employees and bureaucrats
Q.capitalists = 3; // Capitalists and land owners
Q.alevis = 10; // Alevi religious minority
Q.kurds = 5; // Kurdish political movement

Q.classes = ['rural', 'workers', 'petty_bourgeoisie', 'state_employees', 'capitalists', 'alevis', 'kurds'];
Q.parties = ['chp', 'TIP', 'z', 'CGP', 'DP', 'MSP', 'MHP', 'other'];
Q.disk_endorsement = false;
Q.sim_prev_TIP_banned = (typeof Q.TIP_banned !== 'undefined') ? Q.TIP_banned : 1;
Q.TIP_banned = 0; // TİP ran openly in these historical elections; restored after the simulation in post_election
Q.use_decimals = true;
Q.sim_year = 1977;
// the simulation may be entered directly from the start menu, before the main
// game state (and CGP_name) has been initialized
if (typeof Q.CGP_name === 'undefined') {
    Q.CGP_name = 'CGP';
}

// 1977 general election results: CHP 41%, TIP 0.1%, AP 37%, MSP 9%, MHP 6%, DP 2%, CGP 2%, Others 2.9% (remainder).
// Applied uniformly across every demographic group so the simulated national result matches exactly.
for (var c of Q.classes) {
    Q[c + '_chp'] = 41;
    Q[c + '_TIP'] = 0.1;
    Q[c + '_z'] = 37; // AP uses 'z' variable
    Q[c + '_MSP'] = 9;
    Q[c + '_MHP'] = 6;
    Q[c + '_DP'] = 2;
    Q[c + '_CGP'] = 2;
    Q[c + '_other'] = 2.9;
}
!}
go-to: election_algorithm
set-jump: post_election

@1932
on-arrival: {!
// Turkish demographic groups with accurate percentages - 1932 crisis scenario
Q.rural = 45; // Rural population
Q.workers = 15; // Industrial workers  
Q.petty_bourgeoisie = 15; // Small business owners, artisans
Q.state_employees = 7; // State employees and bureaucrats
Q.capitalists = 3; // Capitalists and land owners
Q.alevis = 10; // Alevi religious minority
Q.kurds = 5; // Kurdish political movement

Q.classes = ['rural', 'workers', 'petty_bourgeoisie', 'state_employees', 'capitalists', 'alevis', 'kurds'];
Q.parties = ['chp', 'TIP', 'z', 'CGP', 'DP', 'MSP', 'MHP', 'other'];
Q.disk_endorsement = false;
Q.sim_prev_TIP_banned = (typeof Q.TIP_banned !== 'undefined') ? Q.TIP_banned : 1;
Q.TIP_banned = 0; // TİP ran openly in these historical elections; restored after the simulation in post_election
Q.use_decimals = true;
Q.sim_year = 1979;
// the simulation may be entered directly from the start menu, before the main
// game state (and CGP_name) has been initialized
if (typeof Q.CGP_name === 'undefined') {
    Q.CGP_name = 'CGP';
}

// 1979 general election results: AP 54%, CHP 29%, Socialist Left (shown in TIP's color) 2%,
// MSP 7%, MHP 5%, CGP 2%, DP 0%, Others 1% (remainder).
// Applied uniformly across every demographic group so the simulated national result matches exactly.
for (var c of Q.classes) {
    Q[c + '_z'] = 54; // AP uses 'z' variable
    Q[c + '_chp'] = 29;
    Q[c + '_TIP'] = 2; // Socialist Left, covered in the same color as TIP
    Q[c + '_MSP'] = 7;
    Q[c + '_MHP'] = 5;
    Q[c + '_CGP'] = 2;
    Q[c + '_DP'] = 0;
    Q[c + '_other'] = 1;
}
!}
go-to: election_algorithm
set-jump: post_election

@post_election
on-arrival: {!
// restore the real TIP_banned state now that the simulated votes have been computed,
// so the simulation does not permanently unban TIP in the main game state
if (typeof Q.sim_prev_TIP_banned !== 'undefined') {
    Q.TIP_banned = Q.sim_prev_TIP_banned;
    delete Q.sim_prev_TIP_banned;
}
// set congress proportion to votes
Q.chp_r = Q.chp_votes;
Q.z_r = Q.z_votes;
Q.z_r = Q.z_votes; // AP display variable matches z_votes
Q.TIP_r = Q.TIP_votes;
Q.CGP_r = Q.CGP_votes;
Q.DP_r = Q.DP_votes;
Q.MSP_r = Q.MSP_votes;
Q.MHP_r = Q.MHP_votes;
Q.other_r = Q.other_votes;

// Tiered proportional apportionment, mirroring the algorithm used for the actual
// Grand National Assembly election (see post_election_1928 in election_1928.scene.dry):
// each party's vote share is weighted more heavily the larger it is (in brackets),
// seats are then apportioned out of a fixed 450-seat assembly, and any leftover
// seats from rounding down are settled between CHP and AP.
var totalSeatsTarget = 450;
var majorityThreshold = 226;
Q.majority_threshold = majorityThreshold;
function seatWeightMultiplier(share) {
    if (share <= 5) {
        return 0.5;
    } else if (share <= 15) {
        return 1.15;
    } else if (share <= 27) {
        return 1.25;
    } else if (share <= 32) {
        return 1.5;
    } else if (share <= 40) {
        return 1.8;
    } else {
        return 1.9;
    }
}
Q.largest_party_key = null;
var largestShare = -1;
var weightedShares = {};
var weightedTotal = 0;
for (var party of Q.parties) {
    var share = Q[party + '_r'] || 0;
    var weighted = share * seatWeightMultiplier(share);
    weightedShares[party] = weighted;
    weightedTotal += weighted;
    if (share > largestShare || (share === largestShare && !Q.largest_party_key)) {
        largestShare = share;
        Q.largest_party_key = party;
    }
}
if (weightedTotal <= 0) {
    weightedTotal = 1;
}
Q.total_seats = 0;
for (var party of Q.parties) {
    var seats = Math.max(0, Math.floor(weightedShares[party] / weightedTotal * totalSeatsTarget));
    Q[party + '_seats'] = seats;
    Q.total_seats += seats;
}
Q.sapd_seats = 0;
var seatRemainder = totalSeatsTarget - Q.total_seats;
if (seatRemainder < 0) {
    Q.chp_seats += seatRemainder;
} else if (seatRemainder > 0) {
    Q.z_seats += seatRemainder;
}
Q.total_seats = totalSeatsTarget;
var partyDisplayNames = {
    'chp': 'CHP',
    'TIP': 'TIP',
    'z': 'AP',
    'CGP': Q.CGP_name,
    'DP': 'DP',
    'MSP': 'MSP',
    'MHP': 'MHP',
    'other': 'Other'
};
if (Q.largest_party_key) {
    Q.largest_party = partyDisplayNames[Q.largest_party_key] || Q.largest_party_key.toUpperCase();
} else {
    Q.largest_party = 'CHP';
}

// Coalition options mirrored from the actual Grand National Assembly election scene (election_1928.scene.dry).
Q.left_coalition = (Q.chp_seats || 0) + (Q.TIP_seats || 0);
Q.kemalist_coalition = (Q.chp_seats || 0) + (Q.CGP_seats || 0);
Q.grand_coalition = (Q.chp_seats || 0) + (Q.z_seats || 0);
Q.unholy_coalition = (Q.chp_seats || 0) + (Q.MSP_seats || 0);
Q.bourgeois_coalition = (Q.CGP_seats || 0) + (Q.z_seats || 0) + (Q.DP_seats || 0);
Q.right_coalition = (Q.z_seats || 0) + (Q.DP_seats || 0) + (Q.other_seats || 0) + (Q.MSP_seats || 0);
Q.nationalist_front_coalition = (Q.z_seats || 0) + (Q.CGP_seats || 0) + (Q.MSP_seats || 0) + (Q.MHP_seats || 0);
Q.far_right_coalition = (Q.MSP_seats || 0) + (Q.MHP_seats || 0);
// Socialist Left breakdown for the 1979 simulation result, mirroring the split used
// for the main game's aggregate TIP_r breakdown (see status.scene.dry).
if (Q.sim_year == 1979) {
    Q.TKP_r = Q.TIP_r * 0.25;
    Q.TSIP_r = Q.TIP_r * 0.25;
    Q.TEP_r = Q.TIP_r * 0.10;
    Q.SDP_r = Q.TIP_r * 0.20;
    Q.TIP_socialist_left_r = Q.TIP_r * 0.20;
}
!}

The electoral system uses a tiered proportional apportionment, weighting each party's vote share more heavily the larger it is, out of a 450-seat assembly.
A working majority in this simulation requires 226 seats.
 
**Election results:**

**CHP (Cumhuriyet Halk Partisi):** [+ chp_r +]%

**AP (Adalet Partisi):** [+ z_r +]%

**[? if sim_year == 1979: <span class="wide_tooltip-wrap">Socialist Left<span class="wide_tooltip-tip">TİP: [+ TIP_socialist_left_r +]%; TKP: [+ TKP_r +]%; TSİP: [+ TSIP_r +]%; TEP: [+ TEP_r +]%; SDP: [+ SDP_r +]%</span></span>?][? if sim_year != 1979: TİP (Türkiye İşçi Partisi)?]:** [+ TIP_r +]%

**[+ CGP_name +] (Cumhuriyetçi Güven Partisi):** [+ CGP_r +]%

**DP (Demokratik Parti):** [+ DP_r +]%

**MSP (Milli Selamet Partisi):** [+ MSP_r +]%

**MHP (Milliyetçi Hareket Partisi):** [+ MHP_r +]%

**Other parties:** [+ other_r +]%

**Potential coalitions** *(226 seats needed for a majority)*:

**Left Coalition** (CHP + TİP): [+ left_coalition +] seats

**Kemalist Coalition** (CHP + [+ CGP_name +]): [+ kemalist_coalition +] seats

**Grand Coalition** (CHP + AP): [+ grand_coalition +] seats

**Unholy Coalition** (CHP + MSP): [+ unholy_coalition +] seats

**Bourgeois Coalition** (AP + [+ CGP_name +] + DP): [+ bourgeois_coalition +] seats

**Right-wing Coalition** (AP + DP + Others + MSP): [+ right_coalition +] seats

**Far-right Coalition** (MSP + MHP): [+ far_right_coalition +] seats

**Nationalist Front Coalition** (AP + [+ CGP_name +] + MSP + MHP): [+ nationalist_front_coalition +] seats
